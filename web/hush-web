  flex: 1; font: inherit; color: var(--fg); background: var(--field);
  border: 1px solid var(--line); border-radius: 6px; padding: .5em .7em; outline: none;
}
input:focus { border-color: var(--dim); }
</style>
</head>
<body>
<header><span id="dot"></span><b>hush</b><span id="who">connecting…</span></header>
<main id="log" aria-live="polite"></main>
<form id="f" autocomplete="off">
  <input id="in" maxlength="4000" placeholder="message, or /help" autofocus>
</form>
<script nonce="NONCE">
const token = location.hash.slice(1);
const log = document.getElementById("log"), input = document.getElementById("in");
const dot = document.getElementById("dot"), who = document.getElementById("who");
let me = "", last = "info";
const hist = [], MSG = /^(\d\d:\d\d) (\[dm(?: to [\w.-]+)?\] )?([\w.-]+): (.*)$/s;

// Same palette choice as the terminal client (djb2 hash mod 6).
function hue(name) {
  let h = 5381;
  for (const c of new TextEncoder().encode(name)) h = (h * 33 + c) >>> 0;
  return `var(--n${h % 6})`;
}
function span(cls, text, color) {
  const s = document.createElement("span");
  s.className = cls; s.textContent = text;
  if (color) s.style.color = color;
  return s;
}
// All text goes in through textContent, never as HTML.
function add(line) {
  const stick = log.scrollHeight - log.scrollTop - log.clientHeight < 40;
  const div = document.createElement("div");
  const m = MSG.exec(line);
  let c;
  if (m) {
    div.append(span("ts", m[1] + " "));
    if (m[2]) div.append(span("tag", m[2]));
    div.append(span("name", m[3], hue(m[3])), ": " + m[4]);
    c = "msg";
  } else {
    c = /^!/.test(line) ? "warn" : /^\* /.test(line) ? "sys" : /^\s/.test(line) ? last : "info";
    div.className = c; div.textContent = line;
    const k = /^connected to (\S+) as ([\w.-]+)$/.exec(line);
    if (k) { me = k[2]; who.textContent = `${me} @ ${k[1]}`; document.title = `hush · ${me}`; }
  }
  last = c;
  log.append(div);
  if (stick) log.scrollTop = log.scrollHeight;
}

const es = new EventSource("/events?t=" + encodeURIComponent(token));
es.onopen = () => { dot.className = "on"; };
es.onmessage = e => add(e.data);
es.addEventListener("end", () => {
  es.close(); dot.className = "off"; input.disabled = true;
  who.textContent = (me ? me + " · " : "") + "disconnected";
});
es.onerror = () => {
  if (es.readyState !== EventSource.CLOSED) return void (dot.className = "");
  dot.className = "off"; who.textContent = "disconnected (is hush-web still running?)";
};

let hi = 0;
document.getElementById("f").addEventListener("submit", async e => {
  e.preventDefault();
  const text = input.value;
  if (!text.trim()) return;
  input.value = "";
  hist.push(text); hi = hist.length;
  const r = await fetch("/send", { method: "POST", headers: { "X-Token": token }, body: text })
    .catch(() => null);
  if (!r || !r.ok) add("! could not reach hush-web; message not sent");
});
input.addEventListener("keydown", e => {
  if (e.key === "ArrowUp" && hi > 0) input.value = hist[--hi];
  else if (e.key === "ArrowDown" && hi < hist.length) input.value = hist[++hi] ?? "";
  else return;
  e.preventDefault();
});
if (!token) add("! no token in the URL: open the link hush-web printed");
</script>
</body>
</html>
"""

if __name__ == "__main__":
    main()
